//
//  GateKernels.metal
//  QuantumKit
//
//  Unitary gate compute kernels (single- and multi-qubit).
//
//  Pairwise kernels in this file follow one strict architecture:
//  1) each thread owns exactly one disjoint (|...0...>, |...1...>) amplitude pair,
//  2) pair data is staged in threadgroup memory before arithmetic,
//  3) explicit threadgroup barriers are used before and after mutation,
//  4) controlled gates use precomputed bitmasks (O(1) activation checks).
//

#include <metal_stdlib>
using namespace metal;

static constant uint kPairCountBufferIndex = 15u;

inline uint2 pair_indices(const uint pairID, const uint targetQubit) {
    const uint lowerMask = (1u << targetQubit) - 1u;
    const uint lowerBits = pairID & lowerMask;
    const uint upperBits = pairID >> targetQubit;
    const uint i0 = (upperBits << (targetQubit + 1u)) | lowerBits;
    const uint i1 = i0 | (1u << targetQubit);
    return uint2(i0, i1);
}

inline bool control_mask_is_active(const uint basisIndex, const uint controlMask) {
    return (basisIndex & controlMask) == controlMask;
}

inline float4 load_pair(device const float* realBuffer,
                        device const float* imagBuffer,
                        const uint2 indices) {
    return float4(realBuffer[indices.x], imagBuffer[indices.x], realBuffer[indices.y], imagBuffer[indices.y]);
}

inline void store_pair(device float* realBuffer,
                       device float* imagBuffer,
                       const uint2 indices,
                       const float4 pair) {
    realBuffer[indices.x] = pair.x;
    imagBuffer[indices.x] = pair.y;
    realBuffer[indices.y] = pair.z;
    imagBuffer[indices.y] = pair.w;
}

kernel void hadamard_gate(device float* realBuffer [[buffer(0)]],
                          device float* imagBuffer [[buffer(1)]],
                          constant uint& targetQubit [[buffer(2)]],
                          constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                          uint gid [[thread_position_in_grid]],
                          uint lid [[thread_position_in_threadgroup]],
                          threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float invSqrt2 = M_SQRT1_2_F;
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4((r0 + r1) * invSqrt2,
                      (i0 + i1) * invSqrt2,
                      (r0 - r1) * invSqrt2,
                      (i0 - i1) * invSqrt2);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void pauli_x_gate(device float* realBuffer [[buffer(0)]],
                         device float* imagBuffer [[buffer(1)]],
                         constant uint& targetQubit [[buffer(2)]],
                         constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                         uint gid [[thread_position_in_grid]],
                         uint lid [[thread_position_in_threadgroup]],
                         threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        pair = float4(pair.z, pair.w, pair.x, pair.y);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void pauli_y_gate(device float* realBuffer [[buffer(0)]],
                         device float* imagBuffer [[buffer(1)]],
                         constant uint& targetQubit [[buffer(2)]],
                         constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                         uint gid [[thread_position_in_grid]],
                         uint lid [[thread_position_in_threadgroup]],
                         threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4(i1, -r1, -i0, r0);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void pauli_z_gate(device float* realBuffer [[buffer(0)]],
                         device float* imagBuffer [[buffer(1)]],
                         constant uint& targetQubit [[buffer(2)]],
                         constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                         uint gid [[thread_position_in_grid]],
                         uint lid [[thread_position_in_threadgroup]],
                         threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        pair.z = -pair.z;
        pair.w = -pair.w;
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void s_gate(device float* realBuffer [[buffer(0)]],
                   device float* imagBuffer [[buffer(1)]],
                   constant uint& targetQubit [[buffer(2)]],
                   constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                   uint gid [[thread_position_in_grid]],
                   uint lid [[thread_position_in_threadgroup]],
                   threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair.z = -i1;
        pair.w = r1;
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void t_gate(device float* realBuffer [[buffer(0)]],
                   device float* imagBuffer [[buffer(1)]],
                   constant uint& targetQubit [[buffer(2)]],
                   constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                   uint gid [[thread_position_in_grid]],
                   uint lid [[thread_position_in_threadgroup]],
                   threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float r1 = pair.z;
        const float i1 = pair.w;
        const float c = M_SQRT1_2_F;
        const float s = M_SQRT1_2_F;
        pair.z = (r1 * c) - (i1 * s);
        pair.w = (r1 * s) + (i1 * c);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void cnot_gate(device float* realBuffer [[buffer(0)]],
                      device float* imagBuffer [[buffer(1)]],
                      constant uint2& packed [[buffer(2)]],
                      constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                      uint gid [[thread_position_in_grid]],
                      uint lid [[thread_position_in_threadgroup]],
                      threadgroup float4* pairCache [[threadgroup(0)]]) {
    const uint controlMask = packed.x;
    const uint targetQubit = packed.y;
    const bool active = gid < pairCount;

    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active && control_mask_is_active(indices.x, controlMask)) {
        pair = float4(pair.z, pair.w, pair.x, pair.y);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void rz_gate(device float* realBuffer [[buffer(0)]],
                    device float* imagBuffer [[buffer(1)]],
                    constant uint& targetQubit [[buffer(2)]],
                    constant float& theta [[buffer(3)]],
                    constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                    uint gid [[thread_position_in_grid]],
                    uint lid [[thread_position_in_threadgroup]],
                    threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float halfTheta = theta * 0.5f;
        const float cosH = cos(halfTheta);
        const float sinH = sin(halfTheta);
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4((r0 * cosH) + (i0 * sinH),
                      (i0 * cosH) - (r0 * sinH),
                      (r1 * cosH) - (i1 * sinH),
                      (i1 * cosH) + (r1 * sinH));
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void rx_gate(device float* realBuffer [[buffer(0)]],
                    device float* imagBuffer [[buffer(1)]],
                    constant uint& targetQubit [[buffer(2)]],
                    constant float& theta [[buffer(3)]],
                    constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                    uint gid [[thread_position_in_grid]],
                    uint lid [[thread_position_in_threadgroup]],
                    threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float halfTheta = theta * 0.5f;
        const float cosH = cos(halfTheta);
        const float sinH = sin(halfTheta);
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4((cosH * r0) + (sinH * i1),
                      (cosH * i0) - (sinH * r1),
                      (sinH * i0) + (cosH * r1),
                      (-sinH * r0) + (cosH * i1));
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void ry_gate(device float* realBuffer [[buffer(0)]],
                    device float* imagBuffer [[buffer(1)]],
                    constant uint& targetQubit [[buffer(2)]],
                    constant float& theta [[buffer(3)]],
                    constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                    uint gid [[thread_position_in_grid]],
                    uint lid [[thread_position_in_threadgroup]],
                    threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float halfTheta = theta * 0.5f;
        const float cosH = cos(halfTheta);
        const float sinH = sin(halfTheta);
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4((cosH * r0) - (sinH * r1),
                      (cosH * i0) - (sinH * i1),
                      (sinH * r0) + (cosH * r1),
                      (sinH * i0) + (cosH * i1));
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}


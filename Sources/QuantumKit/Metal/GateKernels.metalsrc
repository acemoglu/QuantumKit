}

kernel void mcz_gate(device float* realBuffer [[buffer(0)]],
                     device float* imagBuffer [[buffer(1)]],
                     constant uint& fullMask [[buffer(2)]],
                     uint id [[thread_position_in_grid]]) {
    if ((id & fullMask) == fullMask) {
        realBuffer[id] = -realBuffer[id];
        imagBuffer[id] = -imagBuffer[id];
    }
}

kernel void s_dagger_gate(device float* realBuffer [[buffer(0)]],
                          device float* imagBuffer [[buffer(1)]],
                          constant uint& targetQubit [[buffer(2)]],
                          constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                          uint gid [[thread_position_in_grid]],
                          uint lid [[thread_position_in_threadgroup]],
                          threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair.z = i1;
        pair.w = -r1;
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void t_dagger_gate(device float* realBuffer [[buffer(0)]],
                          device float* imagBuffer [[buffer(1)]],
                          constant uint& targetQubit [[buffer(2)]],
                          constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                          uint gid [[thread_position_in_grid]],
                          uint lid [[thread_position_in_threadgroup]],
                          threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float c = M_SQRT1_2_F;
        const float s = M_SQRT1_2_F;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair.z = (r1 * c) + (i1 * s);
        pair.w = (i1 * c) - (r1 * s);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void sx_gate(device float* realBuffer [[buffer(0)]],
                    device float* imagBuffer [[buffer(1)]],
                    constant uint& targetQubit [[buffer(2)]],
                    constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                    uint gid [[thread_position_in_grid]],
                    uint lid [[thread_position_in_threadgroup]],
                    threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4(0.5f * (r0 - i0 + r1 + i1),
                      0.5f * (r0 + i0 - r1 + i1),
                      0.5f * (r0 + i0 + r1 - i1),
                      0.5f * (-r0 + i0 + r1 + i1));
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void sx_dagger_gate(device float* realBuffer [[buffer(0)]],
                           device float* imagBuffer [[buffer(1)]],
                           constant uint& targetQubit [[buffer(2)]],
                           constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                           uint gid [[thread_position_in_grid]],
                           uint lid [[thread_position_in_threadgroup]],
                           threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4(0.5f * (r0 + i0 + r1 - i1),
                      0.5f * (-r0 + i0 + r1 + i1),
                      0.5f * (r0 - i0 + r1 + i1),
                      0.5f * (r0 + i0 - r1 + i1));
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void phase_gate(device float* realBuffer [[buffer(0)]],
                       device float* imagBuffer [[buffer(1)]],
                       constant uint& targetQubit [[buffer(2)]],
                       constant float& theta [[buffer(3)]],
                       constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                       uint gid [[thread_position_in_grid]],
                       uint lid [[thread_position_in_threadgroup]],
                       threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float c = cos(theta);
        const float s = sin(theta);
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair.z = (r1 * c) - (i1 * s);
        pair.w = (r1 * s) + (i1 * c);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void u_gate(device float* realBuffer [[buffer(0)]],
                   device float* imagBuffer [[buffer(1)]],
                   constant uint& targetQubit [[buffer(2)]],
                   constant float3& angles [[buffer(3)]],
                   constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                   uint gid [[thread_position_in_grid]],
                   uint lid [[thread_position_in_threadgroup]],
                   threadgroup float4* pairCache [[threadgroup(0)]]) {
    const bool active = gid < pairCount;
    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active) {
        const float theta = angles.x;
        const float phi = angles.y;
        const float lambda = angles.z;
        const float c = cos(theta * 0.5f);
        const float s = sin(theta * 0.5f);
        const float cosL = cos(lambda);
        const float sinL = sin(lambda);
        const float cosP = cos(phi);
        const float sinP = sin(phi);
        const float cosPL = cos(phi + lambda);
        const float sinPL = sin(phi + lambda);
        const float r0 = pair.x;
        const float i0 = pair.y;
        const float r1 = pair.z;
        const float i1 = pair.w;
        pair = float4((c * r0) - s * ((cosL * r1) - (sinL * i1)),
                      (c * i0) - s * ((cosL * i1) + (sinL * r1)),
                      s * ((cosP * r0) - (sinP * i0)) + c * ((cosPL * r1) - (sinPL * i1)),
                      s * ((cosP * i0) + (sinP * r0)) + c * ((cosPL * i1) + (sinPL * r1)));
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

kernel void cz_gate(device float* realBuffer [[buffer(0)]],
                    device float* imagBuffer [[buffer(1)]],
                    constant uint2& packed [[buffer(2)]],
                    constant uint& pairCount [[buffer(kPairCountBufferIndex)]],
                    uint gid [[thread_position_in_grid]],
                    uint lid [[thread_position_in_threadgroup]],
                    threadgroup float4* pairCache [[threadgroup(0)]]) {
    const uint controlMask = packed.x;
    const uint targetQubit = packed.y;
    const bool active = gid < pairCount;

    uint2 indices = uint2(0u);
    float4 pair = float4(0.0f);
    if (active) {
        indices = pair_indices(gid, targetQubit);
        pair = load_pair(realBuffer, imagBuffer, indices);
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    pair = pairCache[lid];
    if (active && control_mask_is_active(indices.x, controlMask)) {
        pair.z = -pair.z;
        pair.w = -pair.w;
    }
    pairCache[lid] = pair;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (active) {
        store_pair(realBuffer, imagBuffer, indices, pairCache[lid]);
    }
}

// SWAP: exchange amplitudes of |...q1=0,q2=1...> and |...q1=1,q2=0...>.
// Full-state kernel; each unordered pair is handled exactly once.
kernel void swap_gate(device float* realBuffer [[buffer(0)]],
                      device float* imagBuffer [[buffer(1)]],
                      constant uint2& qubits [[buffer(2)]],
                      uint id [[thread_position_in_grid]]) {
    const uint q1 = qubits.x;
    const uint q2 = qubits.y;
    const uint b1 = (id >> q1) & 1u;
    const uint b2 = (id >> q2) & 1u;

    if (b1 == 0u && b2 == 1u) {
        const uint partner = (id | (1u << q1)) & ~(1u << q2);
        const float tr = realBuffer[id];
        const float ti = imagBuffer[id];
        realBuffer[id] = realBuffer[partner];
        imagBuffer[id] = imagBuffer[partner];
        realBuffer[partner] = tr;
        imagBuffer[partner] = ti;
    }
}

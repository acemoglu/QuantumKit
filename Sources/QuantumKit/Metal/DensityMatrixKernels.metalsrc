//
//  DensityMatrixKernels.metalsrc
//  QuantumKit
//
//  Exact open-system density-matrix evolution kernels.
//

#include <metal_stdlib>
using namespace metal;

inline float2 dm_complex_add(float2 a, float2 b) {
    return float2(a.x + b.x, a.y + b.y);
}

// Kahan-style compensated addition in complex (float2) form. The compensation term carries the
// low-order bits lost to rounding so long reduction chains keep significantly more precision.
inline void dm_kahan_add_complex(thread float2& sum, thread float2& compensation, float2 value) {
    const float2 corrected = value - compensation;
    const float2 updated = sum + corrected;
    compensation = (updated - sum) - corrected;
    sum = updated;
}

inline float2 dm_complex_mul(float2 a, float2 b) {
    return float2((a.x * b.x) - (a.y * b.y), (a.x * b.y) + (a.y * b.x));
}

inline float2 dm_complex_conj(float2 z) {
    return float2(z.x, -z.y);
}

inline uint dm_index(uint row, uint col, uint stateCount) {
    return row * stateCount + col;
}

kernel void dm_left_multiply_single_qubit(device const float* inReal [[buffer(0)]],
                                          device const float* inImag [[buffer(1)]],
                                          device float* outReal [[buffer(2)]],
                                          device float* outImag [[buffer(3)]],
                                          constant uint& stateCount [[buffer(4)]],
                                          constant uint& targetQubit [[buffer(5)]],
                                          constant uint& controlMask [[buffer(6)]],
                                          constant float2* gateMatrix [[buffer(7)]],
                                          uint id [[thread_position_in_grid]]) {
    const uint elementCount = stateCount * stateCount;
    if (id >= elementCount) {
        return;
    }

    const uint row = id / stateCount;
    const uint col = id - row * stateCount;
    const uint targetMask = (1u << targetQubit);

    if (controlMask != 0u && ((row & controlMask) != controlMask)) {
        outReal[id] = inReal[id];
        outImag[id] = inImag[id];
        return;
    }

    const uint row0 = row & ~targetMask;
    const uint row1 = row0 | targetMask;
    const uint rowBit = (row & targetMask) != 0u ? 1u : 0u;

    const uint idx0 = dm_index(row0, col, stateCount);
    const uint idx1 = dm_index(row1, col, stateCount);

    const float2 rho0 = float2(inReal[idx0], inImag[idx0]);
    const float2 rho1 = float2(inReal[idx1], inImag[idx1]);

    const float2 u00 = gateMatrix[0];
    const float2 u01 = gateMatrix[1];
    const float2 u10 = gateMatrix[2];
    const float2 u11 = gateMatrix[3];

    float2 result = float2(0.0f, 0.0f);
    if (rowBit == 0u) {
        result = dm_complex_add(dm_complex_mul(u00, rho0), dm_complex_mul(u01, rho1));
    } else {
        result = dm_complex_add(dm_complex_mul(u10, rho0), dm_complex_mul(u11, rho1));
    }

    outReal[id] = result.x;
    outImag[id] = result.y;
}

kernel void dm_right_multiply_single_qubit_dagger(device const float* inReal [[buffer(0)]],
                                                   device const float* inImag [[buffer(1)]],
                                                   device float* outReal [[buffer(2)]],
                                                   device float* outImag [[buffer(3)]],
                                                   constant uint& stateCount [[buffer(4)]],
                                                   constant uint& targetQubit [[buffer(5)]],
                                                   constant uint& controlMask [[buffer(6)]],
                                                   constant float2* gateMatrix [[buffer(7)]],
                                                   uint id [[thread_position_in_grid]]) {
    const uint elementCount = stateCount * stateCount;
    if (id >= elementCount) {
        return;
    }

    const uint row = id / stateCount;
    const uint col = id - row * stateCount;
    const uint targetMask = (1u << targetQubit);

    if (controlMask != 0u && ((col & controlMask) != controlMask)) {
        outReal[id] = inReal[id];
        outImag[id] = inImag[id];
        return;
    }

    const uint col0 = col & ~targetMask;
    const uint col1 = col0 | targetMask;
    const uint colBit = (col & targetMask) != 0u ? 1u : 0u;

    const uint idx0 = dm_index(row, col0, stateCount);
    const uint idx1 = dm_index(row, col1, stateCount);

    const float2 rho0 = float2(inReal[idx0], inImag[idx0]);
    const float2 rho1 = float2(inReal[idx1], inImag[idx1]);

    const float2 u00 = gateMatrix[0];
    const float2 u01 = gateMatrix[1];
    const float2 u10 = gateMatrix[2];
    const float2 u11 = gateMatrix[3];

    // Right multiply by U-dagger: out_{r,c} = sum_k rho_{r,k} * (U^dagger)_{k,c},
    // where (U^dagger)_{k,c} = conj(U_{c,k}). This requires both conjugating U and
    // transposing its indices; conjugating alone (rho * conj(U)) is wrong for
    // complex-asymmetric gates like Pauli-Y and yields a negative-trace state.
    float2 result = float2(0.0f, 0.0f);
    if (colBit == 0u) {
        result = dm_complex_add(
            dm_complex_mul(rho0, dm_complex_conj(u00)),
            dm_complex_mul(rho1, dm_complex_conj(u01))
        );
    } else {
        result = dm_complex_add(
            dm_complex_mul(rho0, dm_complex_conj(u10)),
            dm_complex_mul(rho1, dm_complex_conj(u11))
        );
    }

    outReal[id] = result.x;
    outImag[id] = result.y;
}

// Maps a full matrix index to the 2-bit code of its (qubitA, qubitB) subspace bits, with qubitA
// as the high bit. Inverse of `dm2_set_pair`.
inline uint dm2_pair_index(uint index, uint qubitA, uint qubitB) {
    const uint bitA = (index >> qubitA) & 1u;
    const uint bitB = (index >> qubitB) & 1u;
    return (bitA << 1) | bitB;
}

// Returns `base` with its (qubitA, qubitB) bits overwritten by the 2-bit `pair` code
// (qubitA = high bit). Inverse of `dm2_pair_index`.
inline uint dm2_set_pair(uint base, uint qubitA, uint qubitB, uint pair) {
    const uint bitA = (pair >> 1) & 1u;
    const uint bitB = pair & 1u;
    const uint cleared = base & ~((1u << qubitA) | (1u << qubitB));
    return cleared | (bitA << qubitA) | (bitB << qubitB);
}

// Applies a two-qubit Kraus channel rho -> sum_k E_k rho E_k^dagger in a single pass. Each E_k is a
// 4x4 complex matrix (row-major, qubitA = high bit of the 2-bit subspace code) laid out contiguously
// in `krausData` (16 float2 per operator). Every output element rho_{row,col} depends only on the
// 4x4 block rho_{row(r'),col(c')} over the subspace, so the whole correlated channel (e.g. the
// 16-operator two-qubit depolarizing channel) collapses to one GPU dispatch instead of a host-side
// weighted accumulation over the full 4^n matrix.
kernel void dm_apply_two_qubit_kraus(device const float* inReal [[buffer(0)]],
                                     device const float* inImag [[buffer(1)]],
                                     device float* outReal [[buffer(2)]],
                                     device float* outImag [[buffer(3)]],
                                     constant uint& stateCount [[buffer(4)]],
                                     constant uint& qubitA [[buffer(5)]],
                                     constant uint& qubitB [[buffer(6)]],
                                     constant uint& krausCount [[buffer(7)]],
                                     constant float2* krausData [[buffer(8)]],
                                     uint id [[thread_position_in_grid]]) {
    const uint elementCount = stateCount * stateCount;
    if (id >= elementCount) {
        return;
    }

    const uint row = id / stateCount;
    const uint col = id - row * stateCount;
    const uint rIdx = dm2_pair_index(row, qubitA, qubitB);
    const uint cIdx = dm2_pair_index(col, qubitA, qubitB);

    // Cache the 4x4 subspace block of rho this element draws from (16 reads).
    float2 block[4][4];
    for (uint rp = 0u; rp < 4u; rp++) {
        const uint rowP = dm2_set_pair(row, qubitA, qubitB, rp);
        for (uint cp = 0u; cp < 4u; cp++) {
            const uint colP = dm2_set_pair(col, qubitA, qubitB, cp);
            const uint idx = rowP * stateCount + colP;
            block[rp][cp] = float2(inReal[idx], inImag[idx]);
        }
    }

    float2 accum = float2(0.0f, 0.0f);
    float2 accumComp = float2(0.0f, 0.0f);
    for (uint k = 0u; k < krausCount; k++) {
        const uint base = k * 16u;
        for (uint rp = 0u; rp < 4u; rp++) {
            const float2 e_r = krausData[base + rIdx * 4u + rp];
            if (e_r.x == 0.0f && e_r.y == 0.0f) {
                continue;
            }
            // (E_k rho E_k^dagger)_{rIdx,cIdx} term: E_{rIdx,rp} * rho * conj(E_{cIdx,cp}).
            float2 inner = float2(0.0f, 0.0f);
            float2 innerComp = float2(0.0f, 0.0f);
            for (uint cp = 0u; cp < 4u; cp++) {
                const float2 e_c = dm_complex_conj(krausData[base + cIdx * 4u + cp]);
                dm_kahan_add_complex(inner, innerComp, dm_complex_mul(block[rp][cp], e_c));
            }
            dm_kahan_add_complex(accum, accumComp, dm_complex_mul(e_r, inner));
        }
    }

    outReal[id] = accum.x;
    outImag[id] = accum.y;
}

kernel void dm_apply_kraus_single_qubit(device const float* inReal [[buffer(0)]],
                                        device const float* inImag [[buffer(1)]],
                                        device float* outReal [[buffer(2)]],
                                        device float* outImag [[buffer(3)]],
                                        constant uint& stateCount [[buffer(4)]],
                                        constant uint& targetQubit [[buffer(5)]],
                                        constant uint& krausCount [[buffer(6)]],
                                        constant float2* krausData [[buffer(7)]],
                                        uint id [[thread_position_in_grid]]) {
    const uint elementCount = stateCount * stateCount;
    if (id >= elementCount) {
        return;
    }

    const uint row = id / stateCount;
    const uint col = id - row * stateCount;
    const uint targetMask = (1u << targetQubit);

    const uint row0 = row & ~targetMask;
    const uint row1 = row0 | targetMask;
    const uint col0 = col & ~targetMask;
    const uint col1 = col0 | targetMask;

    const uint rowBit = (row & targetMask) != 0u ? 1u : 0u;
    const uint colBit = (col & targetMask) != 0u ? 1u : 0u;

    const float2 rho00 = float2(inReal[dm_index(row0, col0, stateCount)], inImag[dm_index(row0, col0, stateCount)]);
    const float2 rho01 = float2(inReal[dm_index(row0, col1, stateCount)], inImag[dm_index(row0, col1, stateCount)]);
    const float2 rho10 = float2(inReal[dm_index(row1, col0, stateCount)], inImag[dm_index(row1, col0, stateCount)]);
    const float2 rho11 = float2(inReal[dm_index(row1, col1, stateCount)], inImag[dm_index(row1, col1, stateCount)]);

    float2 accum = float2(0.0f, 0.0f);
    float2 accumComp = float2(0.0f, 0.0f);
    for (uint k = 0u; k < krausCount; k++) {
        const uint offset = k * 4u;
        const float2 e_r0 = krausData[offset + (rowBit * 2u) + 0u];
        const float2 e_r1 = krausData[offset + (rowBit * 2u) + 1u];

        const float2 e_c0 = dm_complex_conj(krausData[offset + (colBit * 2u) + 0u]);
        const float2 e_c1 = dm_complex_conj(krausData[offset + (colBit * 2u) + 1u]);

        float2 term = float2(0.0f, 0.0f);
        float2 termComp = float2(0.0f, 0.0f);
        dm_kahan_add_complex(term, termComp, dm_complex_mul(dm_complex_mul(e_r0, rho00), e_c0));
        dm_kahan_add_complex(term, termComp, dm_complex_mul(dm_complex_mul(e_r0, rho01), e_c1));
        dm_kahan_add_complex(term, termComp, dm_complex_mul(dm_complex_mul(e_r1, rho10), e_c0));
        dm_kahan_add_complex(term, termComp, dm_complex_mul(dm_complex_mul(e_r1, rho11), e_c1));
        dm_kahan_add_complex(accum, accumComp, term);
    }

    outReal[id] = accum.x;
    outImag[id] = accum.y;
}
